{
  "prerequisites": [
    {
      "id": "authboundry.local-authority",
      "package": "@authboundry/local + @authboundry/core",
      "kind": "required",
      "present": true,
      "detail": "decision 200 deny (delegation_missing)",
      "feature": "authority.local: a private AuthBoundry started beside the application, whose native server (@authboundry/core) makes every decision",
      "whenAbsent": "applications with authority.local cannot decide anything"
    },
    {
      "id": "authboundry.executor-proof",
      "package": "@authboundry/local + @authboundry/core",
      "kind": "optional",
      "present": true,
      "detail": "{\"agent_credential_id\":\"1702f94c553654e7726c59ff\",\"method\":\"agent_credential\",\"principal_id\":\"agent:feltkit-authority-probe\",\"proven\":true}",
      "feature": "decisions prove the executor by its agent credential (executorProof.proven)",
      "whenAbsent": "decisions still decide; executorProof reads asserted (GUARANTEES)"
    },
    {
      "id": "authboundry-local.per-agent",
      "package": "@authboundry/local",
      "kind": "optional",
      "present": false,
      "detail": "missing registerAgent, revokeAgent, agentCredentialOf, agents",
      "feature": "per-agent delegation: agent callers decide as themselves; grants name agents; ctx.authority.agents",
      "whenAbsent": "agent callers are refused (unavailable) by default; an owner may opt in to shared executor grants with authority.local.agentCallers: \"executor-grants\" (wider authority, recorded as local-executor-grants-opt-in, readiness warns)",
      "upstream": "authboundry 001ce42 (unreleased after 0.1.0)"
    },
    {
      "id": "services.notification-inbox",
      "package": "@appport/services",
      "kind": "optional",
      "present": false,
      "detail": "missing inbox, unreadCount, markAllRead",
      "feature": "ctx.services.notifications.page / unreadCount / markAllRead",
      "whenAbsent": "those three operations refuse FAILED_PRECONDITION naming the release; list() works",
      "upstream": "appport-services 110d72a (unreleased after 0.19.0)"
    },
    {
      "id": "feltdb.set-membership",
      "package": "@feltdb/core",
      "kind": "optional",
      "present": false,
      "detail": "INVALID_QUERY: each condition requires a field and exactly one operator",
      "feature": "ctx.db where … in (set-membership queries)",
      "whenAbsent": "queries with `in` refuse FAILED_PRECONDITION naming the release; eq queries work",
      "upstream": "flow_db 930bc64 (unreleased after 0.21.0)"
    }
  ],
