+import { feltkit, s } from "../../../../src/index.js";
+
+/**
+ * FK-16 authority modes (test/authority-compat.test.ts). The authority configuration is read from the
+ * environment when the application is defined, so one fixture runs each mode:
+ *   FK16_LOCAL     JSON value of authority.local (absent: true)
+ *   FK16_HOSTED    "1": an AuthBoundry address resolves (FK16_AB_URL), so a hosted AuthBoundry decides
+ *   FK16_CAPS      JSON capabilities (absent: the default list; "[]" makes the local authority fail to start)
+ */
+const local = process.env.FK16_LOCAL === undefined ? true : JSON.parse(process.env.FK16_LOCAL);
+const hosted = process.env.FK16_HOSTED === "1";
+export const app = feltkit({
+  name: "localauth",
+  roles: { member: ["work.*"], bot: ["work.*"], svc: ["work.*"] },
+  dev: { users: [{ id: "ada", name: "Ada", roles: ["member"] }, { id: "grace", name: "Grace", roles: ["member"] }] },
+  services: { configuration: true },
+  authority: {
+    local,
+    ...(hosted ? { url: { env: "FK16_AB_URL" } } : {}),
+    application: "localauth",
+    checkCredential: "credential-ref:authboundry-check",
+    executor: { principal: "agent:localauth", ...(hosted ? { credential: "credential-ref:authboundry-local-agent" } : {}) },
+    capabilities: process.env.FK16_CAPS ? JSON.parse(process.env.FK16_CAPS) : ["tasks.create", "docs.publish"],
+  } as never,
+});
+
+export const docs = app.collection("docs", { ownerId: s.string(), text: s.string() });
