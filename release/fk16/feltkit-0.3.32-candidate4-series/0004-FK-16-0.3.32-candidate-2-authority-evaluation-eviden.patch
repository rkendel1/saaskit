@@ -0,0 +1,42 @@
+/**
+ * What FeltKit relies on from AuthBoundry, stated once (FK-16). The runtime, FeltKit's own tests and the
+ * release gate (scripts/release-prerequisites.mjs, which imports this module from the built package) all
+ * decide "is per-agent delegation installed" with this one function, on a STARTED local authority: a
+ * capability is what the running authority offers, not what a version number or a source text suggests.
+ *
+ * And how an authority decision was evaluated: evidence recorded with every decision (never an input to
+ * authorization).
+ */
+
+/** The methods a started @authboundry/local must offer for per-agent delegation (each agent decides as itself). */
+export const PER_AGENT_METHODS = ["registerAgent", "revokeAgent", "agentCredentialOf", "agents"] as const;
+
+/** The per-agent methods a started local authority lacks (empty: per-agent delegation is installed). */
+export function missingPerAgentMethods(authority: object | null | undefined): string[] {
+  if (!authority) return [...PER_AGENT_METHODS];
+  return PER_AGENT_METHODS.filter((m) => typeof (authority as Record<string, unknown>)[m] !== "function");
+}
+
+/** True when a started local authority offers per-agent delegation. */
+export function perAgentDelegation(authority: object | null | undefined): boolean {
+  return missingPerAgentMethods(authority).length === 0;
+}
+
+/**
+ * How an authority decision was evaluated (evidence; never consulted to authorize anything):
+ *   local-executor                 local authority; a person, service or anonymous caller, decided as the executor
+ *   local-per-agent                local authority; an agent decided as itself, with its own grants
+ *   local-executor-grants-opt-in   local authority without per-agent delegation; an agent caller decided as the
+ *                                  executor because the owner set authority.local.agentCallers: "executor-grants"
+ *   hosted-executor                hosted AuthBoundry; a non-agent caller decided as the executor
+ *   hosted-executor-grants         hosted AuthBoundry; an agent caller decided as the executor, with its grants
+ *                                  (the documented hosted contract; authority.local.agentCallers does not govern it)
+ */
+export type AuthorityMode =
+  | "local-executor"
+  | "local-per-agent"
+  | "local-executor-grants-opt-in"
+  | "hosted-executor"
+  | "hosted-executor-grants";
+
+export const AUTHORITY_MODES: readonly AuthorityMode[] = ["local-executor", "local-per-agent", "local-executor-grants-opt-in", "hosted-executor", "hosted-executor-grants"];
