diff --git a/packages/sdk/test/authority-compat.test.ts b/packages/sdk/test/authority-compat.test.ts
new file mode 100644
index 0000000..90f615e
--- /dev/null
+++ b/packages/sdk/test/authority-compat.test.ts
@@ -0,0 +1,99 @@
+/**
+ * FK-16 (0.3.32): agent callers against the INSTALLED @authboundry/local, never skipped.
+ *
+ * 0.3.31 shipped per-agent decisions that need registerAgent, absent from the only published
+ * @authboundry/local (0.1.0); every agent caller's decision became `unavailable`. These tests pin both
+ * contracts and run whichever the installed package provides:
+ *   - without registerAgent: the 0.3.30 executor-grants contract, marked `compatibility`;
+ *   - with it: 0.3.31's per-agent contract (an agent decides as itself; executor grants never apply).
+ * A missing @authboundry/local, or a missing AuthBoundry server, is a FAILURE here, not a skip:
+ * scripts/release-check.mjs relies on this file running.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+import { readFileSync } from "node:fs";
+import { InstanceFactory } from "../src/runtime/instance.js";
+import type { FeltKitRuntime } from "../src/runtime/runtime.js";
+import { startRuntime, tempProject } from "./helpers.js";
+
+const FIXTURE = fileURLToPath(new URL("./fixtures/authority", import.meta.url));
+const require = createRequire(import.meta.url);
+const localPath = fileURLToPath(import.meta.resolve("@authboundry/local")); // throws (fails the file) when not installed: never a skip
+const perAgent = readFileSync(localPath, "utf8").includes("registerAgent");
+const localVersion = (require(require.resolve("@authboundry/local/package.json")) as { version: string }).version;
+
+const ada = { id: "ada", type: "user" as const, roles: ["member"] };
+const mcpBot = { id: "mcp-bot", type: "agent" as const, roles: ["bot"] };
+const run = async (runtime: FeltKitRuntime, who: { id: string; type: "user" | "service" | "agent"; roles: string[] }, name: string, args: Record<string, unknown> = {}) => {
+  const r = await runtime.call(name, args, { principal: who, via: "test" });
+  if (!r.ok) throw Object.assign(new Error(r.error.message), { code: r.error.code });
+  return (r as { value: any }).value;
+};
+
+test(`FK-16: agent callers against the installed @authboundry/local ${localVersion} (${perAgent ? "per-agent" : "executor-grants compatibility"})`, async (t) => {
+  t.diagnostic(`@authboundry/local ${localVersion} at ${localPath}; registerAgent ${perAgent ? "present" : "absent"}`);
+  delete process.env.AUTHBOUNDRY_URL;
+  delete process.env.FELTKIT_CREDENTIAL_AUTHBOUNDRY_CHECK;
+  const { runtime } = await startRuntime({ projectDir: tempProject(FIXTURE), factory: new InstanceFactory() });
+  try {
+    const decide = (who: typeof ada | typeof mcpBot, form: string, capability = "tasks.create", agent?: string) => run(runtime, who, "work:decideForm", { form, capability, ...(agent ? { agent } : {}) });
+
+    // Nothing granted: nobody is allowed, agent or not.
+    assert.equal((await decide(mcpBot, "plain")).allowed, false, "no grant: an agent caller is not allowed");
+    assert.equal((await decide(ada, "plain")).allowed, false, "no grant: the executor is not allowed");
+
+    // Ada grants the application's executor (no agent named: the only grant 0.1.0 can make).
+    const g = await run(runtime, ada, "work:grant", { capabilities: ["tasks.create"] });
+
+    // onBehalfOf normalization (FRAME-GAP-11), for a person caller: every form, one principal, one delegation.
+    for (const form of ["plain", "prefixed", "person", "principal"]) {
+      const d = await decide(ada, form);
+      assert.deepEqual([d.allowed, d.onBehalfOf, d.delegationId, d.agent, d.compatibility], [true, "user:ada", g.id, null, null], `person, ${form}: ${d.reason}`);
+    }
+    // Only what was granted, and only Ada's grant.
+    assert.equal((await decide(ada, "plain", "tasks.delete")).allowed, false, "not granted");
+    assert.equal((await decide(ada, "other")).allowed, false, "Grace granted nothing");
+
+    if (!perAgent) {
+      // ── Compatibility (no registerAgent): the 0.3.30 contract, visibly marked ─────────────────────────
+      for (const form of ["plain", "prefixed", "person", "principal"]) {
+        const d = await decide(mcpBot, form);
+        assert.deepEqual([d.allowed, d.outcome, d.executor, d.agent, d.compatibility, d.onBehalfOf, d.delegationId], [true, "allow", "agent:localauth", null, "executor-grants", "user:ada", g.id], `agent caller, ${form}: ${d.outcome} ${d.reason}`);
+        assert.equal(d.proven, true, "the executor is proven by its own agent credential");
+      }
+      // No authority from elsewhere: not beyond the grant, not from another person.
+      assert.deepEqual([(await decide(mcpBot, "plain", "tasks.delete")).allowed, (await decide(mcpBot, "other")).allowed], [false, false]);
+      // An explicitly named agent never falls back to the executor.
+      for (const [who, agent] of [[mcpBot, "mcp-bot"], [ada, "mcp-bot"], [ada, "scout"]] as const) {
+        const d = await decide(who, "plain", "tasks.create", agent);
+        assert.deepEqual([d.allowed, d.outcome, d.compatibility], [false, "unavailable", null], `${who.id} naming ${agent}`);
+        assert.match(String(d.reason), /registerAgent/);
+      }
+      // An agent can never decide as another agent.
+      const other = await decide(mcpBot, "plain", "tasks.create", "scout");
+      assert.deepEqual([other.allowed, other.outcome], [false, "deny"]);
+      // Per-agent grants and agent registration stay refused: nothing new is possible.
+      await assert.rejects(run(runtime, ada, "work:grant", { capabilities: ["tasks.create"], agent: "mcp-bot" }), (e: any) => e.code === "FAILED_PRECONDITION" && /registerAgent/.test(e.message));
+      await assert.rejects(run(runtime, { id: "op", type: "user", roles: ["operator"] }, "work:registerAgent", { id: "mcp-bot" }), (e: any) => e.code === "FAILED_PRECONDITION");
+      // A declared app.agent run behaves the same (as through 0.3.30).
+      await run(runtime, ada, "work:ask", { agent: "scout", capability: "tasks.create" });
+      await runtime.settleAgents();
+      const notes = await run(runtime, ada, "work:notesList");
+      assert.deepEqual(notes.map((n: any) => [n.by, n.allowed, n.agent]), [["scout", true, null]], JSON.stringify(notes));
+      // Revocation stops the agent caller on the next call.
+      await run(runtime, ada, "work:revoke", { id: g.id });
+      const after = await decide(mcpBot, "plain");
+      assert.deepEqual([after.allowed, after.outcome], [false, "deny"], "revoked");
+    } else {
+      // ── Per-agent delegation installed: 0.3.31's contract, unchanged by the compatibility path ─────────
+      const d = await decide(mcpBot, "plain");
+      assert.equal(d.allowed, false, "the executor's grant never allows an agent caller");
+      assert.equal(d.compatibility, null, "no compatibility marker when per-agent delegation decides");
+      assert.match(String(d.reason), /not an agent registered|delegation_missing/);
+    }
+  } finally {
+    await runtime.close();
+  }
+});
