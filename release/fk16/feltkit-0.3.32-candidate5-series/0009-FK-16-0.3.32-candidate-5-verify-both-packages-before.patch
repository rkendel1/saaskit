diff --git a/packages/sdk/src/runtime/application-authority.ts b/packages/sdk/src/runtime/application-authority.ts
index bb553f9..6f13eec 100644
--- a/packages/sdk/src/runtime/application-authority.ts
+++ b/packages/sdk/src/runtime/application-authority.ts
@@ -112,7 +112,7 @@ export function applicationAuthority(host: AuthorityHost): ApplicationAuthority
       let authorityMode: AuthorityMode | null = null;
       let lasting = false;
       const decisionOf = (outcome: ApplicationAuthorityDecision["outcome"], reason: string): ApplicationAuthorityDecision => ({ allowed: false, outcome, decisionId: null, reason, capability: request.capability, executor, agent, onBehalfOf, delegationId: null, executorProof: { proven: false, method: "asserted", principal: executor, agentCredentialId: null }, authorityMode, ...(lasting ? { lasting } : {}) });
-      if (!config) return decisionOf("unavailable", "No authority is configured (feltkit({ authority })), so nothing is allowed.");
+      if (!config) return ((lasting = true), decisionOf("unavailable", "No authority is configured (feltkit({ authority })), so nothing is allowed.")); // a configuration state
       // Every refusal FeltKit makes itself (before or instead of asking AuthBoundry) is recorded like a decision.
       const refused = async (outcome: ApplicationAuthorityDecision["outcome"], reason: string): Promise<ApplicationAuthorityDecision> => {
         const r = decisionOf(outcome, reason);
@@ -173,7 +173,9 @@ export function applicationAuthority(host: AuthorityHost): ApplicationAuthority
         );
       } catch (error) {
         // A credential that is missing or unreadable is a refusal, named without its value. Nothing was evaluated.
+        // One that is not set (or not usable here) is a configuration state: retrying does not change it.
         authorityMode = null;
+        lasting = ["CREDENTIAL_UNAVAILABLE", "INVALID_REQUEST"].includes(String((error as { code?: unknown }).code));
         return refused("unavailable", `The authority's credential is unavailable: ${(error as Error).message}`);
       }
       // Recorded before it is returned: the evidence (and the attempt it belongs to) has it first.
