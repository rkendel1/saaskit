@@ -0,0 +1,37 @@
+import { s } from "../../../../src/index.js";
+import { app, notes } from "./app.js";
+
+export const grants = app.action({ access: "work.read", handler: async (ctx) => ctx.authority.grants.list() });
+export const grant = app.action({ access: "work.write", args: { capabilities: s.array(s.string()), expiresAt: s.optional(s.number()), agent: s.optional(s.string()) }, handler: async (ctx, a) => ctx.authority.grants.grant(a) });
+export const revoke = app.action({ access: "work.write", args: { id: s.string() }, handler: async (ctx, { id }) => ctx.authority.grants.revoke(id) });
+/** The application acting for someone: AuthBoundry decides from that person's grants. */
+export const mayDoFor = app.action({ access: "work.read", args: { owner: s.string(), capability: s.string() }, handler: async (ctx, { owner, capability }) => (await ctx.authority.decide({ capability, onBehalfOf: `user:${owner}` })).allowed });
+/** As an application calls it (FRAME-GAP-11): onBehalfOf exactly as given, an application id or an AuthBoundry principal. */
+export const mayDoForAsGiven = app.action({ access: "work.read", args: { onBehalfOf: s.string(), capability: s.string() }, handler: async (ctx, { onBehalfOf, capability }) => { const d = await ctx.authority.decide({ capability, onBehalfOf }); return { allowed: d.allowed, onBehalfOf: d.onBehalfOf, reason: d.reason }; } });
+
+// Per-agent delegation: two resident agents, each deciding as itself (test/local-authority.test.ts).
+const decideAndNote = async (ctx: any, input: { capability: string; owner: string }) => {
+  const d = await ctx.authority.decide({ capability: input.capability, onBehalfOf: input.owner });
+  await ctx.db.insert(notes, { text: JSON.stringify({ by: ctx.trigger.agent, allowed: d.allowed, agent: d.agent, reason: d.reason }) });
+};
+app.agent("scout", { principal: { id: "scout", displayName: "Scout" }, roles: ["bot"], access: "work.write", retry: { maxAttempts: 1, backoffMs: 0 }, handler: decideAndNote });
+app.agent("concierge", { principal: { id: "concierge", displayName: "Concierge" }, roles: ["bot"], access: "work.write", retry: { maxAttempts: 1, backoffMs: 0 }, handler: decideAndNote });
+/** A person asks an agent to work for them: the agent runs after the commit, as itself. */
+export const ask = app.mutation({ access: "work.write", args: { agent: s.string(), capability: s.string() }, handler: async (ctx, { agent, capability }) => { ctx.afterCommit.agent(agent, { capability, owner: ctx.auth.principal!.id }); } });
+export const notesList = app.query({ access: "work.read", handler: async (ctx) => (await ctx.db.find(notes, {})).map((n) => JSON.parse(n.text)) });
+/** Any decision, as the caller decides (an agent caller as itself), optionally naming an agent. */
+export const decideAs = app.action({ access: "work.read", args: { onBehalfOf: s.string(), capability: s.string(), agent: s.optional(s.string()) }, handler: async (ctx, a) => { const d = await ctx.authority.decide(a); return { allowed: d.allowed, outcome: d.outcome, agent: d.agent, executor: d.executor, reason: d.reason }; } });
