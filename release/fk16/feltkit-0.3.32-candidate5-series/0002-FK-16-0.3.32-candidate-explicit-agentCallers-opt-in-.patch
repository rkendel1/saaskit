+import { feltkit, s } from "../../../../src/index.js";
+
+/** The authority fixture with authority.local.agentCallers: "executor-grants" (test/authority-compat.test.ts). */
+export const app = feltkit({
+  name: "localauth",
+  roles: { member: ["work.*"], admin: ["*"], bot: ["work.*"], operator: ["feltkit.authority.agents"] },
+  dev: { users: [{ id: "ada", name: "Ada", roles: ["member"] }, { id: "grace", name: "Grace", roles: ["member"] }] },
+  services: { configuration: true },
+  authority: {
+    // FK-16 opt-in: agent callers share the executor's grants while per-agent delegation is not installed.
+    local: { agentCallers: "executor-grants" },
+    application: "localauth",
+    checkCredential: "credential-ref:authboundry-check",
+    executor: { principal: "agent:localauth" },
+    capabilities: ["tasks.create", "tasks.delete", "notes.write"],
+  },
+});
+
+export const notes = app.collection("notes", { text: s.string() });
