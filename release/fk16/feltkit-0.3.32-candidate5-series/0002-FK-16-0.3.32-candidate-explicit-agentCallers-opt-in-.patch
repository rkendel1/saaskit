new file mode 100644
index 0000000..eb25852
--- /dev/null
+++ b/scripts/release-prerequisites.mjs
@@ -0,0 +1,199 @@
+// Release prerequisites (FK-16): what this FeltKit release needs from its upstream packages, verified by
+// CAPABILITY on the installed, registry-resolved copies (a version number proves nothing), plus the
+// compatibility tests that must run (never skip) and the built artifact's content.
+//
+//   node scripts/release-prerequisites.mjs [--json] [--no-tests]
+//
+// required  absent → supported behaviour breaks → the release fails.
+// optional  absent → a documented, safe outcome (a clear refusal) → reported, never silent.
+// Exit 1 on any problem. Used by scripts/release-check.mjs.
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, relative } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const root = fileURLToPath(new URL("..", import.meta.url));
+const sdkDir = fileURLToPath(new URL("../packages/sdk/", import.meta.url));
+const json = process.argv.includes("--json");
+const runTests = !process.argv.includes("--no-tests");
+const problems = [];
+/** The ESM entry ("." import) of a package installed for the SDK, as a file URL. */
+const resolveFrom = (name) => {
+  const found = packageJson(name);
+  if (!found) throw new Error(`${name} is not installed`);
+  const exp = found.pkg.exports;
+  const dot = typeof exp === "string" ? exp : exp?.["."] ?? exp;
+  const entry = typeof dot === "string" ? dot : dot?.import?.default ?? dot?.import ?? dot?.default ?? found.pkg.module ?? found.pkg.main ?? "index.js";
+  return new URL(String(entry), pathToFileURL(found.path)).href;
+};
+/** An ESM-only package (no "require" export), resolved from the SDK: its package.json, read from its directory. */
+const packageJson = (name) => {
+  let dir = sdkDir;
+  for (;;) {
+    const candidate = `${dir}node_modules/${name}/package.json`;
+    if (existsSync(candidate)) return { path: candidate, pkg: JSON.parse(readFileSync(candidate, "utf8")) };
+    const parent = new URL("..", pathToFileURL(dir)).pathname;
+    if (parent === dir) return null;
+    dir = parent;
+  }
+};
+const integrityOf = (name, version) => {
+  try {
+    return execFileSync("npm", ["view", `${name}@${version}`, "dist.integrity"], { cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 60_000 }).trim() || null;
+  } catch {
+    return null;
+  }
+};
+/** sha256 of every file under dir (relative path → hash), skipping nested node_modules. */
+const fileHashes = (dir) => {
+  const out = new Map();
+  const walk = (d) => {
+    for (const e of readdirSync(d)) {
+      if (e === "node_modules") continue;
+      const p = join(d, e);
+      if (statSync(p).isDirectory()) walk(p);
+      else out.set(relative(dir, p), createHash("sha256").update(readFileSync(p)).digest("hex"));
+    }
+  };
+  walk(dir);
+  return out;
+};
+/**
+ * Whether the INSTALLED files are the registry's: the published tarball for that exact version is fetched and
+ * compared file by file. A lockfile entry or a version number cannot show that (an unpublished build can carry
+ * a published version number, as @authboundry/local's source does).
+ */
+const matchesRegistry = (name, version, installedDir) => {
+  const tmp = mkdtempSync(join(tmpdir(), "feltkit-prereq-"));
+  try {
+    const out = execFileSync("npm", ["pack", `${name}@${version}`, "--json", "--pack-destination", tmp], { cwd: tmp, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 120_000 });
+    const file = JSON.parse(out.slice(out.search(/^\[/m)))[0].filename.replace(/^@/, "").replace("/", "-");
+    execFileSync("tar", ["xzf", join(tmp, file), "-C", tmp]);
+    const published = fileHashes(join(tmp, "package"));
+    const installed = fileHashes(installedDir);
+    const differ = [...new Set([...published.keys(), ...installed.keys()])].filter((f) => published.get(f) !== installed.get(f));
+    return { same: differ.length === 0, differ: differ.slice(0, 5) };
+  } catch (error) {
+    return { same: false, differ: [`could not compare: ${String(error?.message ?? error).split("\n")[0]}`] };
+  } finally {
+    rmSync(tmp, { recursive: true, force: true });
+  }
+};
+const lockIntegrity = (name) => {
+  try {
+    const lock = JSON.parse(readFileSync(new URL("../package-lock.json", import.meta.url), "utf8"));
+    return lock.packages?.[`node_modules/${name}`]?.integrity ?? lock.packages?.[`packages/sdk/node_modules/${name}`]?.integrity ?? null;
+  } catch {
+    return null;
+  }
+};
+
+const PREREQUISITES = [
+  {
+    id: "authboundry-local.per-agent",
+    package: "@authboundry/local",
+    upstream: "authboundry 001ce42 (unreleased after 0.1.0)",
+    feature: "per-agent delegation: agent callers decide as themselves; grants name agents; ctx.authority.agents",
+    kind: "optional",
+    whenAbsent: 'agent callers are refused (unavailable) by default; an owner may opt in to shared executor grants with authority.local.agentCallers: "executor-grants" (wider authority, marked and warned)',
+    // The runtime checks typeof authority.registerAgent / agentCredentialOf / revokeAgent / agents on the started
+    // authority; the module's source is the only place to see them without starting a server.
+    probe: async () => {
+      const src = readFileSync(fileURLToPath(resolveFrom("@authboundry/local")), "utf8");
+      return ["registerAgent", "agentCredentialOf", "revokeAgent"].every((m) => new RegExp(`\\b${m}\\b`).test(src));
+    },
+  },
+  {
+    id: "services.notification-inbox",
+    package: "@appport/services",
+    upstream: "appport-services 110d72a (unreleased after 0.19.0)",
+    feature: "ctx.services.notifications.page / unreadCount / markAllRead",
+    kind: "optional",
+    whenAbsent: "those three operations refuse FAILED_PRECONDITION naming the release; list() works",
+    probe: async () => {
+      const services = await import(resolveFrom("@appport/services"));
+      const proto = services.NotificationService?.prototype ?? {};
+      return ["inbox", "unreadCount", "markAllRead"].every((m) => typeof proto[m] === "function");
+    },
+  },
+  {
+    id: "feltdb.set-membership",
+    package: "@feltdb/core",
+    upstream: "flow_db 930bc64 (unreleased after 0.21.0)",
+    feature: "ctx.db where … in (set-membership queries)",
+    kind: "optional",
+    whenAbsent: "queries with `in` refuse FAILED_PRECONDITION naming the release; eq queries work",
+    probe: async () => {
+      const { createFeltDB } = await import(resolveFrom("@feltdb/core"));
+      const db = createFeltDB({ memory: true, namespace: `release-probe-${process.pid}` });
+      try {
+        await db.query({ collection: "p", where: [{ field: "a", in: ["x"] }], limit: 1 });
+        return true;
+      } catch {
+        return false;
+      } finally {
+        await db.close?.();
+      }
+    },
+  },
+];
+
+const report = { prerequisites: [], compatibilityTests: null, artifact: null };
+for (const p of PREREQUISITES) {
+  const found = packageJson(p.package);
+  if (!found) {
+    report.prerequisites.push({ ...p, probe: undefined, installed: null, present: false });
+    (p.kind === "required" ? problems : []).push(`${p.package} is not installed (required for ${p.feature})`);
+    if (p.package === "@authboundry/local") problems.push("@authboundry/local is not installed: the FK-16 compatibility tests cannot run (they never skip)");
+    continue;
+  }
+  const version = found.pkg.version;
+  let present = false;
+  try {
+    present = await p.probe();
+  } catch (error) {
+    present = false;
+    p.probeError = String(error?.message ?? error);
+  }
+  const registry = integrityOf(p.package, version);
+  const locked = lockIntegrity(p.package);
+  const files = registry ? matchesRegistry(p.package, version, join(found.path, "..")) : { same: false, differ: ["not published"] };
+  const entry = { id: p.id, package: p.package, kind: p.kind, installed: version, registryIntegrity: registry, lockIntegrity: locked, filesMatchRegistry: files.same, ...(files.same ? {} : { differingFiles: files.differ }), fromRegistry: Boolean(registry && locked && registry === locked && files.same), present, feature: p.feature, upstream: p.upstream, whenAbsent: p.whenAbsent, ...(p.probeError ? { probeError: p.probeError } : {}) };
+  report.prerequisites.push(entry);
+  if (!entry.fromRegistry) problems.push(`${p.package} ${version}: the installed copy is not the registry's (lock ${locked ?? "none"}, npm ${registry ?? "unpublished"}${files.same ? "" : `; files differ: ${files.differ.join(", ")}`})`);
+  if (!present && p.kind === "required") problems.push(`${p.package} ${version} lacks a REQUIRED capability: ${p.feature}`);
+}
+
+// The built artifact carries the FK-16 correction (the release packs dist/).
+const built = new URL("../packages/sdk/dist/runtime/local-authority.js", import.meta.url);
+const builtSrc = existsSync(built) ? readFileSync(built, "utf8") : "";
+report.artifact = { distLocalAuthority: existsSync(built), hasAgentCallers: builtSrc.includes("agentCallersMode") && builtSrc.includes('"executor-grants"') };
+if (!report.artifact.distLocalAuthority) problems.push("packages/sdk/dist is not built: run npm run build before the release check");
+else if (!report.artifact.hasAgentCallers) problems.push("the built packages/sdk/dist does not contain the FK-16 agentCallers correction");
+
+// The compatibility tests: they must run, all of them, and none may skip.
+if (runTests) {
+  let out = "";
+  try {
+    out = execFileSync(process.execPath, ["--import", "tsx", "--test", "--test-concurrency=1", "test/authority-compat.test.ts"], { cwd: sdkDir, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], timeout: 600_000 });
+  } catch (error) {
+    out = String(error.stdout ?? "") + String(error.stderr ?? "");
+  }
+  const count = (k) => Number(new RegExp(`^# ${k} (\\d+)`, "m").exec(out)?.[1] ?? NaN);
+  report.compatibilityTests = { tests: count("tests"), pass: count("pass"), fail: count("fail"), skipped: count("skipped"), todo: count("todo") };
+  const c = report.compatibilityTests;
+  if (!(c.tests >= 3)) problems.push(`FK-16 compatibility tests: expected at least 3, ran ${c.tests}`);
+  if (c.fail !== 0) problems.push(`FK-16 compatibility tests: ${c.fail} failed`);
+  if (c.skipped !== 0 || c.todo !== 0) problems.push(`FK-16 compatibility tests: ${c.skipped} skipped / ${c.todo} todo — they must run`);
+}
+
+if (json) console.log(JSON.stringify({ ...report, problems }, null, 2));
+else {
+  for (const p of report.prerequisites) console.log(`${p.present ? "✓" : p.kind === "required" ? "✗" : "–"} ${p.kind.padEnd(8)} ${p.package}@${p.installed ?? "missing"} ${p.present ? "has" : "LACKS"} ${p.feature}${p.present ? "" : `\n    when absent: ${p.whenAbsent}\n    upstream: ${p.upstream}`}${p.fromRegistry ? "" : "\n    NOT the registry artifact"}`);
+  if (report.compatibilityTests) console.log(`compatibility tests: ${JSON.stringify(report.compatibilityTests)}`);
+  console.log(`artifact: ${JSON.stringify(report.artifact)}`);
+  for (const p of problems) console.error(`✗ ${p}`);
+}
+process.exit(problems.length ? 1 : 0);
